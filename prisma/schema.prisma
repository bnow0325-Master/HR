generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  department        String?
  position          String?
  email             String?            @unique
  phone             String?
  hireDate          DateTime?
  terminationDate   DateTime?
  workMinutesPerDay Int                @default(480)
  systemRole        String             @default("MEMBER")
  attendanceEnabled Boolean            @default(true)
  leaveEnabled      Boolean            @default(true)
  workboardEnabled  Boolean            @default(false)
  pinHash           String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  records           AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  businessTrips     BusinessTrip[]

  @@index([active, code])
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  type       String
  timestamp  DateTime @default(now())
  method     String   @default("MANUAL")
  verified   Boolean  @default(false)
  latitude   Float?
  longitude  Float?
  note       String?
  createdAt  DateTime @default(now())

  @@index([employeeId, timestamp])
}

model LeaveRequest {
  id             String   @id @default(cuid())
  employee       Employee @relation(fields: [employeeId], references: [id])
  employeeId     String
  leaveType      String
  leaveDate      DateTime
  unitsMinutes   Int
  reason         String?
  status         String   @default("PENDING")
  reviewerNote   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId, leaveDate])
  @@index([status, leaveDate])
}

model BusinessTrip {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("REGISTERED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, startDate, endDate])
  @@index([status, startDate])
}
