generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Employee {
  id                       String                    @id @default(cuid())
  code                     String                    @unique
  name                     String
  department               String?
  position                 String?
  email                    String?                   @unique
  externalLoginId          String?                   @unique
  phone                    String?
  personalEmail            String?                   @unique
  homeAddress              String?                   @db.Text
  emergencyContactPhone    String?
  profilePhotoData         Bytes?
  profilePhotoMimeType     String?
  profilePhotoUpdatedAt    DateTime?
  hireDate                 DateTime?
  terminationDate          DateTime?
  workMinutesPerDay        Int                       @default(480)
  systemRole               String                    @default("MEMBER")
  attendanceEnabled        Boolean                   @default(true)
  leaveEnabled             Boolean                   @default(true)
  workboardEnabled         Boolean                   @default(false)
  locationConsentAt        DateTime?
  locationConsentVersion   String?
  pinHash                  String?
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @default(now()) @updatedAt
  records                  AttendanceRecord[]
  leaveRequests            LeaveRequest[]
  businessTrips            BusinessTrip[]
  approvalAudits           ApprovalAudit[]
  approvalDocuments        ApprovalDocument[]
  naverWorksDailyRecords   NaverWorksDailyRecord[]
  naverWorksAbsenceRecords NaverWorksAbsenceRecord[]

  @@index([active, code])
}

model NaverWorksDailyRecord {
  id                    String    @id @default(cuid())
  employee              Employee  @relation(fields: [employeeId], references: [id])
  employeeId            String
  baseDate              DateTime  @db.Date
  workStyle             String?
  workType              String?
  schedule              String?   @db.Text
  checkInAt             DateTime?
  checkOutAt            DateTime?
  checkInRaw            String?   @db.Text
  checkOutRaw           String?   @db.Text
  workLocation          String?   @db.Text
  breakMinutes          Int       @default(0)
  offsiteMinutes        Int       @default(0)
  absenceMinutes        Int       @default(0)
  late                  Boolean   @default(false)
  earlyLeave            Boolean   @default(false)
  requiredWorkCompliant String?   @db.Text
  scheduleCompliant     String?   @db.Text
  scheduleVariance      String?   @db.Text
  sourceLoginId         String
  sourceRow             Int
  importedAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([employeeId, baseDate])
  @@index([baseDate])
  @@index([sourceLoginId])
}

// Immutable archive of NAVER WORKS absence documents. These records are kept
// separate from new HR requests so the original document number remains auditable.
model NaverWorksAbsenceRecord {
  id                 String    @id @default(cuid())
  employee           Employee  @relation(fields: [employeeId], references: [id])
  employeeId         String
  sourceDocumentNo   String    @unique
  sourceEmployeeName String
  sourceDepartment   String?
  absenceType        String
  unitsMinutes       Int
  periodText         String    @db.Text
  requestedOn        DateTime? @db.Date
  status             String    @default("IMPORTED")
  sourceRow          Int
  importedAt         DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([employeeId, requestedOn])
  @@index([absenceType, requestedOn])
}

model AttendanceRecord {
  id          String    @id @default(cuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  type        String
  timestamp   DateTime  @default(now())
  method      String    @default("MANUAL")
  verified    Boolean   @default(false)
  latitude    Float?
  longitude   Float?
  note        String?   @db.Text
  cancelledAt DateTime?
  cancelNote  String?
  createdAt   DateTime  @default(now())

  @@index([employeeId, timestamp])
  @@index([employeeId, cancelledAt, timestamp])
}

model LeaveRequest {
  id              String    @id @default(cuid())
  employee        Employee  @relation(fields: [employeeId], references: [id])
  employeeId      String
  leaveType       String
  leaveDate       DateTime
  unitsMinutes    Int
  reason          String?   @db.Text
  status          String    @default("PENDING")
  reviewerNote    String?   @db.Text
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId, leaveDate])
  @@index([status, leaveDate])
}

model BusinessTrip {
  id              String    @id @default(cuid())
  employee        Employee  @relation(fields: [employeeId], references: [id])
  employeeId      String
  startDate       DateTime
  endDate         DateTime
  reason          String    @db.Text
  status          String    @default("PENDING")
  reviewerNote    String?   @db.Text
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId, startDate, endDate])
  @@index([status, startDate])
}

model ApprovalAudit {
  id             String   @id @default(cuid())
  employee       Employee @relation(fields: [employeeId], references: [id])
  employeeId     String
  requestKind    String
  requestId      String
  action         String
  fromStatus     String?
  toStatus       String
  actorEmail     String?
  actorName      String
  note           String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([requestKind, requestId, createdAt])
  @@index([employeeId, createdAt])
}

model ApprovalTemplate {
  id             String             @id @default(cuid())
  name           String
  description    String?            @db.Text
  fieldsJson     String             @db.Text
  active         Boolean            @default(true)
  createdByEmail String
  updatedByEmail String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  documents      ApprovalDocument[]

  @@index([active, updatedAt])
}

model ApprovalDocument {
  id                String          @id @default(cuid())
  documentNo        String          @unique
  template          ApprovalTemplate @relation(fields: [templateId], references: [id])
  templateId        String
  templateName      String
  templateFieldsJson String           @db.Text
  requester         Employee        @relation(fields: [requesterId], references: [id])
  requesterId       String
  requesterEmail    String
  requesterName     String
  requesterDepartment String?
  title             String
  valuesJson        String          @db.Text
  status            String          @default("PENDING")
  approverEmail     String
  approverName      String
  decisionNote      String?         @db.Text
  submittedAt       DateTime        @default(now())
  decidedAt         DateTime?
  version           Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  events            ApprovalDocumentEvent[]

  @@index([requesterId, submittedAt])
  @@index([status, submittedAt])
  @@index([approverEmail, status, submittedAt])
}

model ApprovalDocumentEvent {
  id            String           @id @default(cuid())
  document      ApprovalDocument @relation(fields: [documentId], references: [id])
  documentId    String
  action        String
  fromStatus    String?
  toStatus      String
  actorEmail    String
  actorName     String
  note          String?          @db.Text
  createdAt     DateTime         @default(now())

  @@index([documentId, createdAt])
}
