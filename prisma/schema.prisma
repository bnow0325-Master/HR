generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Employee {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  department        String?
  position          String?
  email             String?            @unique
  externalLoginId   String?            @unique
  phone             String?
  personalEmail     String?            @unique
  homeAddress       String?            @db.Text
  emergencyContactPhone String?
  profilePhotoData  Bytes?
  profilePhotoMimeType String?
  profilePhotoUpdatedAt DateTime?
  hireDate          DateTime?
  terminationDate   DateTime?
  workMinutesPerDay Int                @default(480)
  systemRole        String             @default("MEMBER")
  attendanceEnabled Boolean            @default(true)
  leaveEnabled      Boolean            @default(true)
  workboardEnabled  Boolean            @default(false)
  pinHash           String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  records           AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  businessTrips     BusinessTrip[]
  naverWorksDailyRecords NaverWorksDailyRecord[]

  @@index([active, code])
}

model NaverWorksDailyRecord {
  id                    String    @id @default(cuid())
  employee              Employee  @relation(fields: [employeeId], references: [id])
  employeeId            String
  baseDate              DateTime  @db.Date
  workStyle             String?
  workType              String?
  schedule              String?   @db.Text
  checkInAt             DateTime?
  checkOutAt            DateTime?
  checkInRaw            String?   @db.Text
  checkOutRaw           String?   @db.Text
  workLocation          String?   @db.Text
  breakMinutes          Int       @default(0)
  offsiteMinutes        Int       @default(0)
  absenceMinutes        Int       @default(0)
  late                  Boolean   @default(false)
  earlyLeave            Boolean   @default(false)
  requiredWorkCompliant String?   @db.Text
  scheduleCompliant     String?   @db.Text
  scheduleVariance      String?   @db.Text
  sourceLoginId         String
  sourceRow             Int
  importedAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([employeeId, baseDate])
  @@index([baseDate])
  @@index([sourceLoginId])
}

model AttendanceRecord {
  id          String    @id @default(cuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  type        String
  timestamp   DateTime  @default(now())
  method      String    @default("MANUAL")
  verified    Boolean   @default(false)
  latitude    Float?
  longitude   Float?
  note        String?    @db.Text
  cancelledAt DateTime?
  cancelNote  String?
  createdAt   DateTime  @default(now())

  @@index([employeeId, timestamp])
  @@index([employeeId, cancelledAt, timestamp])
}

model LeaveRequest {
  id             String   @id @default(cuid())
  employee       Employee @relation(fields: [employeeId], references: [id])
  employeeId     String
  leaveType      String
  leaveDate      DateTime
  unitsMinutes   Int
  reason         String?   @db.Text
  status         String   @default("PENDING")
  reviewerNote   String?   @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId, leaveDate])
  @@index([status, leaveDate])
}

model BusinessTrip {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  startDate  DateTime
  endDate    DateTime
  reason     String   @db.Text
  status     String   @default("REGISTERED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, startDate, endDate])
  @@index([status, startDate])
}
