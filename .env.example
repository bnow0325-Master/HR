# --- Database (PostgreSQL) ---
# 프로덕션/로컬 모두 PostgreSQL을 사용합니다. 운영 표준은 Neon입니다.
# Neon 대시보드의 "Connection string"을 그대로 붙여넣으세요. sslmode=require 권장.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- 회사 위치 (GPS 지오펜싱) ---
# 사무실 중심 좌표와 허용 반경(미터). 이 반경 밖에서는 출퇴근 불가.
# 주소: 서울시 중구 명동길 73, 6층 (명동성당 인근)
# ※ 아래 좌표는 명동길 73 부근 추정값입니다. 실제 건물 입구에서
#   폰 GPS로 위도·경도를 찍어 정확히 보정하는 것을 권장합니다.
OFFICE_LATITUDE="37.5636"
OFFICE_LONGITUDE="126.9868"
OFFICE_RADIUS_METERS="150"

# --- 동적 QR (TOTP) ---
# 사무실 키오스크 화면에 표시되는 QR을 생성/검증하는 공유 비밀키.
# 반드시 무작위 문자열로 교체하세요. (예: openssl rand -hex 32)
QR_TOTP_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"
# QR 갱신 주기(초). 짧을수록 캡처 재사용에 강함.
QR_STEP_SECONDS="30"

# --- 내부 직원명부 연동 ---
# BNOW SIGN 서버가 계약용 재직 직원 정보를 조회할 때 사용하는 전용 토큰입니다.
# 다른 비밀키와 구분되는 32바이트 이상의 무작위 값을 사용하세요.
EMPLOYEE_DIRECTORY_API_TOKEN="CHANGE_ME_TO_A_RANDOM_INTERNAL_TOKEN"

# --- 라이브카우톡 직원 권한 폐기 ---
# 퇴사, WorkBoard 권한 해제, 회사 이메일 변경 시 LC_CHAT의 세션과 푸시 기기를 즉시 삭제합니다.
CUSTOMER_CHAT_INTERNAL_URL="https://main.bnow.co.kr/api/customer-chat-internal"
CUSTOMER_CHAT_INTERNAL_KEY="CHANGE_ME_TO_MATCH_LC_CHAT_INTERNAL_KEY"

# --- BNOW 사내 통합 인증 (Keycloak, 서버 전용) ---
BNOW_IDENTITY_URL="https://auth.bnow.co.kr"
BNOW_IDENTITY_REALM="bnow"
BNOW_IDENTITY_ADMIN_CLIENT_ID="hr-directory-sync"
BNOW_IDENTITY_ADMIN_CLIENT_SECRET="CHANGE_ME_KEYCLOAK_CLIENT_SECRET"
BNOW_IDENTITY_LOGIN_CLIENT_ID="hr-server"
BNOW_IDENTITY_LOGIN_CLIENT_SECRET="CHANGE_ME_HR_CLIENT_SECRET"
BNOW_IDENTITY_LOGIN_REDIRECT_URI="https://hr.bnow.co.kr/api/auth/company/callback"
# HR HttpOnly 세션과 로그인 흐름 서명에 사용하는 32바이트 이상의 무작위 키입니다.
BNOW_IDENTITY_SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_SESSION_SECRET"

# --- 재직증명서 회사 정보 ---
HR_CERTIFICATE_COMPANY_NAME="(주)비노우"
HR_CERTIFICATE_REPRESENTATIVE_NAME="추동현"
HR_CERTIFICATE_REPRESENTATIVE_TITLE="대표이사"
HR_CERTIFICATE_BUSINESS_NUMBER="132-86-37808"
HR_CERTIFICATE_CORPORATE_NUMBER="110111-8903430"
HR_CERTIFICATE_COMPANY_ADDRESS="서울특별시 중구 명동길 73, 6층(명동1가)"
